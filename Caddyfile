# Caddy now runs behind Traefik (Dokploy handles SSL & ports 80/443)
# Caddy only handles internal routing on port 80
:80 {
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /admin/* {
        reverse_proxy backend:8000
    }

    handle_path /static/* {
        root * /srv/staticfiles
        file_server
    }

    handle_path /media/* {
        root * /srv/media
        file_server
    }

    handle_path /* {
        root * /srv
        file_server
        try_files {path} {path}/ /index.html
    }
}
