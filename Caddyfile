}

# Redirect bare IP to domain
:80 {
    redir https://smartshop1.us{uri} permanent
}

# Main Site - HTTPS with Auto SSL
smartshop1.us, www.smartshop1.us {
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /admin/* {
        reverse_proxy backend:8000
    }

    handle_path /static/* {
        root * /srv/staticfiles
        file_server
    }

    handle_path /media/* {
        root * /srv/media
        file_server
    }

    handle_path /* {
        root * /srv
        file_server
        try_files {path} {path}/ /index.html
    }
}
